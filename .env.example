# Copy to .env for local development (`make run` loads it). Never commit .env.
LISTEN_ADDR=:8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://secretmgr:secretmgr@localhost:5432/secretmgr?sslmode=disable
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
# At least 32 bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
SESSION_TTL=8h
# Comma-separated; empty = any Google account
ALLOWED_DOMAINS=
ADMIN_EMAILS=
ALLOWED_NAMESPACES=default
LOG_LEVEL=debug
